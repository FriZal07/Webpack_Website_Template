{
  "name": "webpack_website_template",
  "version": "1.0.0",
  "description": "template for future files that have the base webpack included",
  "homepage": "https://github.com/FriZal07/Webpack_Website_Template#readme",
  "bugs": {
    "url": "https://github.com/FriZal07/Webpack_Website_Template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FriZal07/Webpack_Website_Template.git"
  },
  "license": "UNLICENSED",
  "author": "FriZal",
  "type": "module",
  "main": "script.js",
  "devDependencies": {
    "css-loader": "^7.1.5",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^4.0.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "scripts": {
    "build": "webpack --config webpack.prod.js",
    "dev": "webpack serve --config webpack.dev.js",
    "gitadd": "git add dist -f",
    "gitqdcommit": "git commit -m 'quick deploy'",
    "deploy": "git push origin $(git subtree split --prefix dist HEAD):gh-pages --force && git reset HEAD~1"
  }
}
